# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/lavista

# ---- Auth (keep secret; rotate in production) ----
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# ---- App ----
APP_URL=http://localhost:4044
# Comma separated extra origins allowed to call the API from a browser (e.g. Expo web). Native apps don't need this.
CORS_ORIGINS=

# ---- Uploads ----
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25

# ---- Integrations ----
# Website contact form -> POST /api/v1/integrations/leads with header x-api-key
LEAD_WEBHOOK_KEY=change-me
# Meta (Facebook/Instagram) Lead Ads webhook
META_VERIFY_TOKEN=change-me
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# ---- Seed (npm run seed) ----
ADMIN_NAME=LA-VISTA Admin
ADMIN_EMAIL=admin@lavista.in
ADMIN_PASSWORD=change-me
